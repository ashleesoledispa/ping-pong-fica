# Copia este archivo como .env para correr en tu computadora.
# En Vercel estas mismas variables van en Settings → Environment Variables.

# Acceso al panel secreto (/admin)
ADMIN_USER=Ashlee22
ADMIN_PASS=ashlee22
# Texto largo al azar para firmar la sesión del panel (recomendado en Vercel)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Supabase (OBLIGATORIO en Vercel; en tu compu es opcional)
# Si lo dejas vacío en tu compu, los datos se guardan en la carpeta storage/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cierre de inscripciones (hora de Ecuador)
REG_DEADLINE=2026-11-30T23:59:59-05:00

# Cupos máximos (0 = sin límite)
MAX_CUPOS=64

# Valor de la inscripción (solo para el total recaudado del panel)
PRECIO=2.5

# Dominio obligatorio del correo (vacío = acepta cualquier correo)
EMAIL_DOMAIN=udla.edu.ec

# Puerto local
PORT=3000
